# Velatum needs no secrets. Everything that touches your files runs in the browser:
# there is no API key, database or server-side service to configure.

# Which bench adapter the page uses. "real" (the default) runs the attack bench in a Web Worker
# inside the visitor's tab, with a 2 s timeout, one retry and a main-thread fallback. "fake"
# forces the main-thread bench. Any value other than "fake" means "real". No secret is needed.
ADAPTER_MODE=real

# Set automatically by next.config.ts at build time from public/brand/*.png. Do not set it by hand.
NEXT_PUBLIC_BRAND_FILES=
