# Velatum needs no secrets. Everything that touches your files runs in the browser:
# there is no API key, database or server-side service to configure.

# Which bench adapter the page uses. "fake" is the seeded main-thread bench (the default).
# "real" is reserved for the Web Worker bench added in Phase 2; any other value means "fake".
ADAPTER_MODE=fake

# Set automatically by next.config.ts at build time from public/brand/*.png. Do not set it by hand.
NEXT_PUBLIC_BRAND_FILES=
