# Velatum needs no secrets. Everything that touches your files runs in the browser:
# there is no API key, database or server-side service to configure.

# Which bench adapter the page uses. "fake" (the default) runs the attack bench on the page's
# main thread. "real" runs the same bench in a Web Worker inside the visitor's tab, with a
# timeout, one retry and a main-thread fallback. No secret is needed for either, so the farm
# runner sets ADAPTER_MODE=real in production. Any other value means "fake".
ADAPTER_MODE=fake

# Set automatically by next.config.ts at build time from public/brand/*.png. Do not set it by hand.
NEXT_PUBLIC_BRAND_FILES=
